# Server Configuration
PORT=3001
NODE_ENV=development

# RailRadar API Configuration
# Get your API key from https://railradar.in/docs or your RailRadar account dashboard
RAILRADAR_API_KEY=your_railradar_api_key_here

# RailRadar Base API URL (default: https://api.railradar.in/v1)
RAILRADAR_BASE_URL=https://api.railradar.in/v1

# Cache TTL Settings (in seconds)
CACHE_TTL_LIVE=60
CACHE_TTL_STATIC=3600
