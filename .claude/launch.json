{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "railsync-api",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "uvicorn", "api:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "port": 8000,
      "autoPort": true
    },
    {
      "name": "railsync-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5000,
      "autoPort": true
    }
  ]
}
