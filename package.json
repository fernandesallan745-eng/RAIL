{
  "name": "gati",
  "version": "1.0.0",
  "description": "GATI — dynamic ETA forecasting and conflict-aware recommendation for Indian Railways coaching trains (SIH 2026, PS 26028). Node gateway + Leaflet live map over the RailRadar API.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.js",
    "dev": "node scripts/serve.js --watch",
    "server": "node src/server.js",
    "ios:sync": "node scripts/prepare-ios-web.js && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:lan": "node scripts/ios-lan-url.js",
    "ios:icon": "node scripts/set-app-icon.js"
  },
  "keywords": [
    "gati",
    "railway",
    "train",
    "eta",
    "konkan",
    "railradar",
    "express",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "leaflet": "^1.9.4",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
